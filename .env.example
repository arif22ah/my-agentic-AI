# --- LLM ---------------------------------------------------------------
# Default is 'mock-key' (Offline Self-Healing Synthesizer — works with zero API key!).
# Paste a valid OpenAI key ONLY if you have active OpenAI billing/credits.
OPENAI_API_KEY=mock-key
LLM_MODEL=openai:gpt-4o-mini

# --- Observability (optional) -----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=self-healing-codegen

# --- Loop ----------------------------------------------------------------
MAX_ATTEMPTS=5

# --- Sandbox -------------------------------------------------------------
SANDBOX_MODE=docker
SANDBOX_IMAGE=selfheal-sandbox:latest
SANDBOX_TIMEOUT_S=60
SANDBOX_MEM=1g
SANDBOX_CPUS=1.0

# --- Postgres ------------------------------------------------------------
DATABASE_URL=postgresql://selfheal:selfheal@localhost:5432/selfheal
